#: frontend/base.js:8
msgid "微信支付支付"
msgstr "微信支付支付"

#: src/Helpers.php:114
msgid "request failed, please try again"
msgstr "请求失败，请重试"

#: src/Init.php:106 src/PaymentGateway.php:350
msgid "Settings"
msgstr "设置"

#: src/PaymentGateway.php:116
msgid "WeChatPay Payment Gateway By Wenprise"
msgstr "WeChatPay Payment Gateway By Wenprise"

#: src/PaymentGateway.php:119
msgid "WeChat Pay payment gateway for WooCommerce"
msgstr "WooCommerce的微信支付支付网关"

#: src/PaymentGateway.php:184
msgid "Enable / Disable"
msgstr "启用/停用"

#: src/PaymentGateway.php:185
msgid "Enable this payment gateway"
msgstr "启用此付款网关"

#: src/PaymentGateway.php:190
msgid "Title"
msgstr "标题"

#: src/PaymentGateway.php:192
msgid "Wechatpay"
msgstr "微信支付"

#: src/PaymentGateway.php:195
msgid "Description"
msgstr "描述"

#: src/PaymentGateway.php:197
msgid "Pay securely using WeChat Pay"
msgstr "使用微信支付安全快捷的支付"

#: src/PaymentGateway.php:201
msgid "Order Number Prefix"
msgstr "订单号前缀"

#: src/PaymentGateway.php:203
msgid "Only alphabet or number Allowed"
msgstr "仅允许字母或数字"

#: src/PaymentGateway.php:204
msgid "WC-"
msgstr "WC-"

#: src/PaymentGateway.php:207
msgid "WeChat Official Account Developer ID(AppID)"
msgstr "微信公众号开发者ID（AppID）"

#: src/PaymentGateway.php:209
msgid ""
"Enter your WeChat Official Account Developer ID(AppID). Setup and obtain it "
"in \"Settings and Development > Basic configuration\"."
msgstr ""
"输入您的微信公众号开发者ID(AppID)，在“设置和开发>基本配置”中设置并获取。"

#: src/PaymentGateway.php:212
msgid "WeChat Official Account Developer Password(AppSecret)"
msgstr "微信公众号开发者密码(AppSecret)"

#: src/PaymentGateway.php:214
msgid ""
"Enter your WeChat Official Account Developer Password(AppSecret). Setup and "
"obtain it in \"Settings and Development > Basic configuration\"."
msgstr ""
"输入您的微信公众号开发者密码(AppSecret)，在“设置和开发>基本配置”中设置并获"
"取。"

#: src/PaymentGateway.php:217
msgid "WeChat miniApp AppID(小程序ID)"
msgstr "微信小程序AppID(小程序ID)"

#: src/PaymentGateway.php:219
msgid ""
"Enter your WeChat MiniApp AppId. Setup and obtain it in 「开发 > 开发管理 > "
"开发设置」。"
msgstr "输入您的微信小程序AppID，在「开发 > 开发管理 > 开发设置」页面中获取。"

#: src/PaymentGateway.php:222
msgid "WeChat MiniApp AppSecret(小程序密钥)"
msgstr "微信小程序AppSecret(小程序密钥)"

#: src/PaymentGateway.php:224
msgid ""
"Enter your WeChat MiniApp AppSecret. Setup and obtain it in 「开发 > 开发管"
"理 > 开发设置」。"
msgstr "输入您的微信AppSecret，在「开发 > 开发管理 > 开发设置」页面中获取。"

#: src/PaymentGateway.php:227
msgid "WeChatPay Mch Id"
msgstr "微信支付商户ID"

#: src/PaymentGateway.php:229
#, php-format
msgid ""
"Enter your WeChatPay Mch Id. obtain it in <a target=_blank href=\"%s\">here</"
"a>."
msgstr "输入微信支付商户号。在<a target=_blank href=\"%s\">这里</a>获取。"

#: src/PaymentGateway.php:232
msgid "WeChatPay APIv2 Secret"
msgstr "微信支付 APIv2 密钥"

#: src/PaymentGateway.php:234
#, php-format
msgid ""
"Enter your WeChatPay APIv2 Secret that Setup in <a target=_blank "
"href=\"%s\">here</a>。支付授权目录和 H5 支付域名为： %s, 扫码回调链接为: %s."
msgstr ""
"输入微信支付APIv2密钥，在<a target=_blank href=\"%s\">这里</a>设置。支付授权"
"目录和 H5 支付域名为：<code>%s</code>,  <code>扫码回调链接为: %s</code>。"

#: src/PaymentGateway.php:237
msgid "apiclient_cert.pem path"
msgstr "apiclient_cert.pem 路径"

#: src/PaymentGateway.php:239
#, php-format
msgid ""
"Enter the absolute path of apiclient_cert.pem file that can access by the "
"site, used by refund action。<br/>Ex: <code>/home/apiclient_cert.pem</code>，"
"For security *DO NOT* place it in public dir. Setup in <a target=_blank "
"href=\"%s\">here</a>"
msgstr ""
"输入退款时使用的 apiclient_cert.pem 文件的绝对路径，确保 Web 服务器程序可以正"
"常访问该路径.<br/> 如： <code>/home/apiclient_cert.pem</code>，安全起见，请**"
"不要** 把该文件放在公共目录。<a target=_blank href=\"%s\">在这里</a>设置和获"
"取 apiclient_cert.pem 文件"

#: src/PaymentGateway.php:242
msgid "apiclient_key.pem Path"
msgstr "apiclient_key.pem 路径"

#: src/PaymentGateway.php:244
#, php-format
msgid ""
"Enter the absolute path of apiclient_key.pem file that can access by the "
"site, used by refund action. <br/>Ex: <code>/home/apiclient_key.pem</code>，"
"For security *DO NOT* place it in public dir. Setup in <a target=_blank "
"href=\"%s\">here</a>"
msgstr ""
"输入退款时使用的 apiclient_key.pem 文件的绝对路径，确保 Web 服务器程序可以正"
"常访问该路径.<br/> 如： <code>/home/apiclient_key.pem</code>，安全起见，请**"
"不要** 把该文件放在公共目录。<a target=_blank href=\"%s\">在这里</a>设置和获"
"取 apiclient_key.pem 文件"

#: src/PaymentGateway.php:247
msgid "Debug Mode"
msgstr "调试模式"

#: src/PaymentGateway.php:248
msgid "Enable debug mod"
msgstr "启用调试模式"

#: src/PaymentGateway.php:250
msgid "If checked, plugin will show program errors in frontend."
msgstr "如果启用，会在前端显示详情的错误信息。"

#: src/PaymentGateway.php:254
msgid "Checkout Style"
msgstr "结帐样式"

#: src/PaymentGateway.php:258
msgid "Show qrcode in modal"
msgstr "在模态窗口中显示二维码"

#: src/PaymentGateway.php:259
msgid "Show qrcode in page"
msgstr "在页面中显示二维码"

#: src/PaymentGateway.php:263
msgid "QR Code Timeout (minutes)"
msgstr "二维码超时时间（分钟）"

#: src/PaymentGateway.php:265
msgid ""
"Set how long a WeChat Pay Native QR code stays valid before the checkout "
"page asks the customer to refresh it."
msgstr ""
"设置微信支付原生二维码的有效时长，超时后，结算页面会提示用户刷新二维码。"

#: src/PaymentGateway.php:277
msgid "Exchange Rate"
msgstr "汇率"

#: src/PaymentGateway.php:279
#, php-format
msgid ""
"Please set the %s against Chinese Yuan exchange rate, eg if your currency is "
"US Dollar, then you should enter 6.19"
msgstr "请设置 %s 转人民币的汇率，例如您的商店货币时美元，请填写 6.19"

#: src/PaymentGateway.php:351
msgid "Return to payments"
msgstr "返回付款页面"

#: src/PaymentGateway.php:373
#, php-format
msgid ""
"WeChatPay is enabled, but the store currency is not set to Chinese Yuan. "
"Please <a href=\"%1s\">set the %2s against the Chinese Yuan exchange rate</"
"a>."
msgstr ""
"微信支付已启用，但是您的商店货币不是人民币，请<a href=\"%1s\">设置 %2s 转人民"
"币的汇率</a>。"

#: src/PaymentGateway.php:387 src/PaymentGateway.php:1202
msgid "Calling WeChat Pay, please wait a moment..."
msgstr "正在拉起微信支付，请稍候..."

#: src/PaymentGateway.php:619 src/PaymentGateway.php:708
#: src/PaymentGateway.php:854
#, php-format
msgid "Pay for order %1$s at %2$s"
msgstr "支付网站「%2$s」中的订单：%1$s"

#: src/PaymentGateway.php:632
msgid "Failed to generate WeChat Pay QR code."
msgstr "生成微信支付二维码失败。"

#: src/PaymentGateway.php:805 src/PaymentGateway.php:880
msgid "WeChat payment configuration error, please contact us."
msgstr "微信支付配置错误，请联系我们。"

#: src/PaymentGateway.php:827
msgid "Invalid request data."
msgstr "请求数据无效。"

#: src/PaymentGateway.php:837
msgid "Invalid payment request."
msgstr "支付请求无效。"

#: src/PaymentGateway.php:931
#, php-format
msgid "Refunded %1$s"
msgstr "退款 %1$s"

#: src/PaymentGateway.php:1184
msgid "查询支付结果"
msgstr "查询支付结果"

#: src/PaymentGateway.php:1207 src/PaymentGateway.php:1209
msgid "Use WeChat Pay"
msgstr "使用微信支付"

#: src/PaymentGateway.php:1224
msgid "Please scan the QR code with WeChat to finish the payment."
msgstr "请使用微信扫描二维码完成支付。"

#: src/PaymentGateway.php:1235 src/PaymentGateway.php:1273
msgid "Refresh QR code"
msgstr "刷新二维码"

#: src/PaymentGateway.php:1241 src/PaymentGateway.php:1279
msgid "Generating QR code..."
msgstr "正在获取二维码..."

#: src/PaymentGateway.php:1316
msgid "Invalid order."
msgstr "订单无效。"

#: src/PaymentGateway.php:1362
msgid "Invalid request."
msgstr "请求无效。"

#: src/PaymentGateway.php:1371
msgid "You are not allowed to refresh this QR code."
msgstr "您无权刷新此二维码。"

#: src/PaymentGateway.php:1377
msgid "Payment successful"
msgstr "支付成功"

#: src/PaymentGateway.php:1388
msgid "QR code refreshed."
msgstr "二维码已更新。"

#: src/PaymentGateway.php:1392
msgid "Failed to refresh WeChat Pay QR code, please try again."
msgstr "无法刷新微信支付二维码，请重试。"

#: src/PaymentGateway.php:1422
msgid "Too many requests, please try again later."
msgstr "请求过多，请稍后再试。"

#: src/PaymentGateway.php:1451
msgid "Mini app login failed."
msgstr "小程序登录失败。"

